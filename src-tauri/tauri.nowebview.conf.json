{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACC Pitwall",
  "version": "2.0.3",
  "identifier": "com.acc.config-generator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ACC Pitwall",
        "width": 1400,
        "height": 900,
        "devtools": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {
      "../acc-server.zip": "acc-server.zip",
      "resources/LICENSE-WinSW.txt": "LICENSE-WinSW.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  },
  "plugins": {}
}
